diff --git a/cloudbuild.yaml b/cloudbuild.yaml
new file mode 100644
index 0000000..0fdb295
--- /dev/null
+++ b/cloudbuild.yaml
@@ -0,0 +1,29 @@
+# Build and push one Taj SaaS app image.
+# This file intentionally does not deploy to Cloud Run yet.
+# Configure _APP and _IMAGE per Cloud Build trigger.
+
+substitutions:
+  _APP: customer
+  _IMAGE: customer-app
+  _REGION: asia-southeast2
+  _REPOSITORY: taj-saas
+
+steps:
+  - name: "gcr.io/cloud-builders/docker"
+    args:
+      - "build"
+      - "--build-arg"
+      - "APP=${_APP}"
+      - "-t"
+      - "${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/${_IMAGE}:$BUILD_ID"
+      - "."
+
+  - name: "gcr.io/cloud-builders/docker"
+    args:
+      - "push"
+      - "${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/${_IMAGE}:$BUILD_ID"
+
+options:
+  logging: CLOUD_LOGGING_ONLY
+
+timeout: "1800s"
