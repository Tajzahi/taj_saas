# ==========================================
# taj_saas - Global Environment Variables Template
# Copy this file to .env and fill in the values
# ==========================================

# -----------------------------------------------
# [REQUIRED] Database & ORM Connection (Neon PostgreSQL)
# -----------------------------------------------
DATABASE_URL="postgresql://username:password@hostname/dbname?sslmode=require"

# -----------------------------------------------
# [REQUIRED] Better Auth Configuration
# Generate a strong secret: openssl rand -base64 32
# -----------------------------------------------
BETTER_AUTH_SECRET="your-32-character-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
COOKIE_DOMAIN=".localhost"

# -----------------------------------------------
# [REQUIRED] Tenant Identification
# Must match the slug in the `tenants` table
# -----------------------------------------------
NEXT_PUBLIC_TENANT_SLUG="taj-saas"

# -----------------------------------------------
# [REQUIRED] Ably Realtime (Order Notifications)
# -----------------------------------------------
ABLY_API_KEY="your-ably-api-key"
NEXT_PUBLIC_ABLY_API_KEY="your-ably-api-key"

# -----------------------------------------------
# [OPTIONAL] Gemini AI (Customer Portal Chatbot)
# -----------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------
# [OPTIONAL] Sentry Error Tracking
# -----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="taj-saas"
SENTRY_PROJECT="taj-saas"

# -----------------------------------------------
# [OPTIONAL] PostHog Product Analytics
# -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
