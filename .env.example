# ==========================================
# taj_saas - Global Environment Variables Template
# ==========================================

# Database & ORM Connection (Neon Live Database)
DATABASE_URL="postgresql://username:password@hostname/dbname?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="use-a-strong-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"
COOKIE_DOMAIN=".localhost"

# Ably Realtime Key
ABLY_API_KEY="your-ably-api-key"
NEXT_PUBLIC_ABLY_API_KEY="your-ably-api-key"

# Gemini AI (For Customer Portal AI Chatbot)
GEMINI_API_KEY="your-gemini-api-key"

# Sentry (Optional for error tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="taj-saas"
SENTRY_PROJECT="taj-saas"

# PostHog (Optional for analytics)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
